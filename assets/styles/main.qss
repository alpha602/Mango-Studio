/* Mango Studio 2.0 - Final Polish */
QMainWindow, QWidget#right_panel, QWidget#content_widget { background-color: #13111C; color: #E2E2E9; font-family: "Segoe UI", sans-serif; font-size: 14px; }

/* Punkt 4: Sidebar Spacing & Sizing */
QListWidget#sidebar_nav { background-color: #1A1725; border-right: 1px solid #2A2538; padding: 30px 15px; outline: none; }
QListWidget#sidebar_nav::item { padding: 16px 20px; border-radius: 10px; margin-bottom: 8px; color: #9A95A8; font-weight: 600; font-size: 16px; }
QListWidget#sidebar_nav::item:selected { background-color: #2D2442; color: #FFFFFF; }
QListWidget#sidebar_nav::item:hover:!selected { background-color: #221E30; color: #D1CDE0; }

QWidget#header_widget { background-color: #13111C; border-bottom: 1px solid #2A2538; }
QLabel#app_title { color: #FFFFFF; font-size: 28px; font-weight: 800; background: transparent; }
QLabel#app_subtitle { color: #7B758C; font-size: 13px; background: transparent; }
QLineEdit#search_bar { background-color: #1E1B29; color: #FFFFFF; border: 1px solid #2A2538; border-radius: 24px; padding: 10px 20px; font-size: 15px; selection-background-color: #7B52FF; }
QLineEdit#search_bar:focus { border: 1px solid #7B52FF; }

QPushButton#accent_button { background-color: #7B52FF; color: #FFFFFF; border: none; border-radius: 20px; padding: 10px 24px; font-size: 14px; font-weight: bold; }
QPushButton#accent_button:hover { background-color: #8F6BFF; }
QPushButton#accent_button:pressed { background-color: #653EE6; }
QPushButton#accent_button:disabled { background-color: #3A3259; color: #8A859C; }

QLabel#status_label { color: #9A95A8; font-size: 14px; background: transparent; }
QLabel#section_header { color: #FFFFFF; font-size: 18px; font-weight: bold; background: transparent; padding: 10px 0px; }
QPushButton#filter_chip { background-color: transparent; color: #9A95A8; border: 1px solid #2A2538; border-radius: 16px; padding: 6px 16px; font-size: 13px; font-weight: 600; }
QPushButton#filter_chip:hover { background-color: #1E1B29; color: #FFFFFF; border: 1px solid #3D3552; }
QPushButton#filter_chip:checked { background-color: #7B52FF; color: #FFFFFF; border: 1px solid #7B52FF; }

QComboBox#sort_combo, QPushButton#view_toggle { background-color: #1E1B29; color: #E2E2E9; border: 1px solid #2A2538; border-radius: 8px; padding: 8px 12px; font-size: 13px; }
QComboBox#sort_combo:hover, QPushButton#view_toggle:hover { border: 1px solid #3D3552; }
QComboBox#sort_combo::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView { background-color: #1E1B29; color: #E2E2E9; selection-background-color: #7B52FF; border: 1px solid #2A2538; outline: none; }

QFrame#game_card { background-color: #1A1725; border: 1px solid #2A2538; border-radius: 12px; }
QFrame#game_card:hover { background-color: #221E30; border: 1px solid #7B52FF; }
QLabel#game_cover { background: transparent; border-radius: 8px; }
QLabel#launcher_icon { background: rgba(26, 23, 37, 0.8); border-radius: 12px; border: 1px solid #2A2538; }
QLabel#favorite_badge { background: transparent; font-size: 16px; }
QLabel#game_name { color: #FFFFFF; font-size: 14px; font-weight: bold; background: transparent; }
QLabel#game_meta { color: #7B758C; font-size: 12px; background: transparent; }
QLabel#empty_placeholder { color: #5A546B; font-size: 18px; padding: 60px; background: transparent; }

QWidget#footer_widget { background-color: #13111C; border-top: 1px solid #2A2538; }
QLabel#footer_version, QLabel#footer_status, QLabel#system_monitor { color: #5A546B; font-size: 12px; background: transparent; }

QScrollBar:vertical { background: #13111C; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #2A2538; border-radius: 4px; min-height: 40px; }
QScrollBar::handle:vertical:hover { background: #7B52FF; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QMenu { background-color: #1E1B29; color: #E2E2E9; border: 1px solid #2A2538; border-radius: 8px; padding: 6px; }
QMenu::item { padding: 8px 24px; border-radius: 4px; background: transparent; }
QMenu::item:selected { background-color: #7B52FF; color: #FFFFFF; }
QMenu::separator { height: 1px; background: #2A2538; margin: 5px 10px; }
QToolTip { background-color: #1E1B29; color: #FFFFFF; border: 1px solid #7B52FF; border-radius: 4px; padding: 6px; }

/* Punkt 6: Settings Dialog größer und cleaner */
QDialog { background-color: #1A1725; }
QTabWidget::pane { border: 1px solid #2A2538; border-radius: 8px; background-color: #13111C; padding: 15px; }
QTabBar::tab { background-color: #1E1B29; color: #9A95A8; padding: 12px 24px; border-top-left-radius: 8px; border-top-right-radius: 8px; margin-right: 4px; font-weight: bold; font-size: 14px; }
QTabBar::tab:selected { background-color: #7B52FF; color: #FFFFFF; }
QListWidget, QComboBox { background-color: #1E1B29; color: #E2E2E9; border: 1px solid #2A2538; border-radius: 8px; padding: 8px; font-size: 14px; }
QListWidget::item { padding: 10px; border-radius: 4px; }
QListWidget::item:selected { background-color: #2D2442; }
QCheckBox { spacing: 10px; color: #E2E2E9; font-size: 14px; }
QCheckBox::indicator { width: 20px; height: 20px; border: 1px solid #2A2538; border-radius: 4px; background-color: #1E1B29; }
QCheckBox::indicator:checked { background-color: #7B52FF; border: 1px solid #7B52FF; }
QPushButton { background-color: #2A2538; color: #FFF; border: none; border-radius: 6px; padding: 10px 20px; font-size: 14px; }
QPushButton:hover { background-color: #3D3552; }